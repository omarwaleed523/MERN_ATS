{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --config jest.config.js --verbose --coverage",
    "test:watch": "jest --config jest.config.js --watch",
    "test:unit": "jest --config jest.config.js --testPathPattern=tests/unit --verbose",
    "test:integration": "jest --config jest.config.js --testPathPattern=tests/integration --verbose",
    "test:e2e": "jest --config jest.config.js --testPathPattern=tests/e2e --verbose",
    "test:report": "jest --config jest.config.js --coverage --coverageReporters=json --coverageReporters=lcov --coverageReporters=text && node tests/generate-report.js",
    "test:html": "jest --config jest.config.js --verbose --coverage && start test-report.html",
    "test:excel": "node tests/generate-test-documentation.js && start test-documentation.xlsx",
    "test:all-reports": "npm run test:html && npm run test:excel",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.1",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "nodemon": "^3.1.9",
    "pdf-parse": "^1.1.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.1.0",
    "mongodb-memory-server": "^9.5.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js",
      "services/**/*.js",
      "!node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
